# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file — it's already covered by .gitignore.

# RPC endpoint for Sepolia testnet (get a free one from Alchemy or Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key-here

# Private key of the wallet that will deploy the contract and call logEvent
# This should be a funded TESTNET-ONLY wallet — never use a real wallet's key
PRIVATE_KEY=your-testnet-wallet-private-key-here

# Filled in after deployment (Day 1 afternoon) — used by the interaction scripts
CONTRACT_ADDRESS=

# A sample complaint id to use when running the interaction/history scripts
SAMPLE_COMPLAINT_ID=1
